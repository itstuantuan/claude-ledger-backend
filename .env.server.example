APP_ENV=production
APP_PUBLISHED_PORT=8080
POSTGRES_DB=cloud_ledger
POSTGRES_USER=cloud_ledger
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://cloud_ledger:replace-with-url-encoded-password@postgres:5432/cloud_ledger?sslmode=disable
CORS_ORIGINS=https://ledger-test.example.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h
COOKIE_SECURE=true
LOG_LEVEL=info
