APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://cloud_ledger:cloud_ledger_dev@localhost:5432/cloud_ledger?sslmode=disable
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_PING_TIMEOUT=3s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Phase 2 will require strong, independently generated secrets.
JWT_SECRET=change-me-access-secret-at-least-32-bytes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h
REFRESH_COOKIE_NAME=cloud_ledger_refresh
COOKIE_SECURE=false
